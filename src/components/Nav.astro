---
const links = [
  { href: '/', label: 'Home' },
  { href: '/andamio', label: 'Andamio' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---
<nav class="flex justify-between items-center px-6 py-5 border-b border-muted/20">
  <a href="/" class="font-display text-lg tracking-tight">WASTED TALENT</a>
  <ul class="flex gap-6 text-sm">
    {links.map(link => (
      <li>
        <a href={link.href} class="hover:text-accent transition-colors duration-150">
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</nav>