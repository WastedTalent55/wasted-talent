---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<figure class="not-prose my-10">
  <img
    src={`${base}${src}`}
    alt={alt}
    loading="lazy"
    class="w-full border border-accent-light/20"
  />
  {caption && (
    <figcaption class="font-mono text-xs text-muted mt-2">{caption}</figcaption>
  )}
</figure>