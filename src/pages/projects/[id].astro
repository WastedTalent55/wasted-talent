---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  return allProjects
    .filter((p: CollectionEntry<'projects'>) => p.id !== 'andamio')
    .map((p: CollectionEntry<'projects'>) => ({ params: { id: p.id }, props: { project: p } }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout title={`${project.data.title} — Wasted Talent`} description={project.data.summary}>
  <section class="px-6 py-16 max-w-3xl mx-auto">
    <h1 class="font-display text-4xl mb-2">{project.data.title}</h1>
    <p class="text-muted mb-4">{project.data.summary}</p>
    <div class="flex gap-2 flex-wrap mb-8">
      {project.data.tags.map((tag: string) => (
        <span class="text-xs border border-accent-soft/40 text-accent-soft px-2 py-1">{tag}</span>
      ))}
    </div>
    {project.data.demoUrl && <Button href={project.data.demoUrl}>Ver demo</Button>}
    <article class="prose prose-invert mt-10 max-w-none">
      <Content />
    </article>
  </section>
</Layout>