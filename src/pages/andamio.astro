---
import { getEntry, render, type CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const project = await getEntry('projects', 'andamio') as CollectionEntry<'projects'>;
const { Content } = await render(project);
---
<Layout title="Andamio — Wasted Talent" description="Una app para organizar cotizaciones y proyectos de remodelación freelance. Construida con Angular, Node.js y MySQL.">
  <section class="px-6 py-16 max-w-3xl mx-auto">
    <h1 class="font-display text-4xl mb-2">{project.data.title}</h1>
    <p class="text-muted mb-4">{project.data.summary}</p>
    <div class="flex gap-2 flex-wrap mb-8">
      {project.data.tags.map((tag: string) => (
        <span class="text-xs border border-muted/40 px-2 py-1">{tag}</span>
      ))}
    </div>
    {project.data.repoUrl && (
      <Button href={project.data.repoUrl} variant="secondary">Ver repositorio</Button>
    )}
    <article class="prose prose-invert mt-10 max-w-none">
      <Content />
    </article>
  </section>
</Layout>